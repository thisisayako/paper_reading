      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>LuaLaTeX; modified using iTextSharp.LGPLv2.Core 3.7.4.0</pdf:Producer>
         <pdf:PDFVersion>1.5</pdf:PDFVersion>
         <pdf:Keywords>gender; grants; research; workforce</pdf:Keywords>
         <pdf:Trapped>False</pdf:Trapped>
